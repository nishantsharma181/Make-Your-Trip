<% layout("/layouts/boilerplate") %>

<style>

  /* =========================
     CATEGORY FILTERS
  ========================= */

  .filters {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    overflow-x: auto;
    padding: 20px 8px;
    margin-bottom: 30px;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    min-width: 76px;
    text-align: center;
    color: #555;
    text-decoration: none;
    flex-shrink: 0;
  }

  .filter-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 10px;

    background: #ffffff;

    border-radius: 15px;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow: 0 3px 10px rgba(0,0,0,0.08);

    transition: all 0.2s ease;
  }

  .filter-icon i {
    font-size: 22px;
    color: #635bff;
  }

  .filter p {
    margin: 0;
    font-size: 14px;
    color: #444;
  }

  .filter:hover {
    color: #635bff;
  }

  .filter:hover .filter-icon {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.12);
  }

  .filter:hover p {
    color: #635bff;
  }


  /* =========================
     TAX
  ========================= */

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 10px 15px;
    margin-bottom: 20px;
  }


  /* =========================
     LISTING CARDS
  ========================= */

  .listing-col {
    align-self: flex-start !important;
  }

  .card {
    border: none !important;
    margin-bottom: 2rem;
    height: auto !important;
    min-height: 0 !important;
  }

  .card-img-top {
    border-radius: 1rem !important;
    width: 100% !important;
    height: 20rem !important;
    object-fit: cover !important;
    display: block;
  }

  .card-body {
    padding: 0 !important;
    height: auto !important;
  }

  .card-text {
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .listing-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .listing-link:hover {
    color: inherit;
  }


  /* =========================
     FLIGHT SEARCH
  ========================= */

  .flight-search-section {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
  }

  .flight-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .flight-subtitle {
    color: #6b7280;
    margin-bottom: 25px;
  }

  .flight-label {
    font-weight: 500;
    margin-bottom: 7px;
  }

  .flight-input {
    height: 58px;
    border-radius: 12px !important;
    border: 1px solid #ddd !important;
  }

  .flight-search-button {
    height: 58px;
    border-radius: 12px;
    background: #635bff;
    color: white;
    border: none;
    font-weight: 600;
    width: 100%;
  }

  .flight-search-button:hover {
    background: #5149e8;
    color: white;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 768px) {

    .filters {
      justify-content: flex-start;
      gap: 20px;
    }

    .filter {
      min-width: 70px;
    }

    .filter-icon {
      width: 52px;
      height: 52px;
    }

    .flight-search-section {
      padding: 20px;
    }

  }

</style>


<!-- =========================================
     CATEGORY FILTERS
========================================= -->

<div class="filters">


  <!-- TRENDING -->

  <a
    href="/listings?category=trending"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-fire"></i>

    </div>

    <p>
      Trending
    </p>

  </a>


  <!-- ROOMS -->

  <a
    href="/listings?category=rooms"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-bed"></i>

    </div>

    <p>
      Rooms
    </p>

  </a>


  <!-- FLIGHTS -->

  <a
    href="/flights"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-plane"></i>

    </div>

    <p>
      Flights
    </p>

  </a>


  <!-- BUS -->

  <a
    href="/buses"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-bus"></i>

    </div>

    <p>
      Bus
    </p>

  </a>


  <!-- TAXI -->

  <a
    href="/listings?category=taxi"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-taxi"></i>

    </div>

    <p>
      Taxi
    </p>

  </a>


  <!-- BIKE -->

  <a
    href="/bikes"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-motorcycle"></i>

    </div>

    <p>
      Bike
    </p>

  </a>


  <!-- TRAIN -->

  <a
    href="/listings?category=train"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-train-tram"></i>

    </div>

    <p>
      Train
    </p>

  </a>


  <!-- CITIES -->

  <a
    href="/listings?category=cities"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-mountain-city"></i>

    </div>

    <p>
      Cities
    </p>

  </a>


  <!-- MOUNTAINS -->

  <a
    href="/listings?category=mountains"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-mountain"></i>

    </div>

    <p>
      Mountains
    </p>

  </a>


  <!-- SWIMMING -->

  <a
    href="/listings?category=swimming"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-person-swimming"></i>

    </div>

    <p>
      Swimming
    </p>

  </a>


  <!-- CAMPING -->

  <a
    href="/listings?category=camping"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-campground"></i>

    </div>

    <p>
      Camping
    </p>

  </a>


  <!-- FARMS -->

  <a
    href="/listings?category=farms"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-plate-wheat"></i>

    </div>

    <p>
      Farms
    </p>

  </a>


  <!-- ARCTIC -->

  <a
    href="/listings?category=arctic"
    class="filter"
  >

    <div class="filter-icon">

      <i class="fa-solid fa-snowflake"></i>

    </div>

    <p>
      Arctic
    </p>

  </a>


</div>



<!-- =========================================
     TAX TOGGLE
========================================= -->

<div class="tax-toggle">

  <div class="form-check-reverse form-switch">

    <input
      class="form-check-input"
      type="checkbox"
      role="switch"
      id="flexSwitchCheckDefault"
    >

    <label
      class="form-check-label"
      for="flexSwitchCheckDefault"
    >
      Display total after taxes
    </label>

  </div>

</div>



<!-- =========================================
     LISTINGS
========================================= -->

<div
  class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3"
>

  <% for (let listing of allListings) { %>


    <div class="col listing-col">


      <a
        href="/listings/<%= listing._id %>"
        class="listing-link"
      >


        <div class="card">


          <!-- IMAGE -->

          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
          >


          <!-- DETAILS -->

          <div class="card-body">


            <p class="card-text">


              <b>
                <%= listing.title %>
              </b>


              <br>


              ₹ <%= listing.price.toLocaleString("en-IN") %> / night


              <span class="tax-info">
                + 18% GST
              </span>


            </p>


          </div>


        </div>


      </a>


    </div>


  <% } %>


</div>



<!-- =========================================
     FLIGHT SEARCH
========================================= -->

<div class="container mt-5 mb-5">

  <div class="row">

    <div class="col-md-10 mx-auto">


      <div class="flight-search-section">


        <!-- TITLE -->

        <h3 class="flight-title">

          ✈️ Find your next flight

        </h3>


        <p class="flight-subtitle">

          Compare routes and book your journey in a few steps.

        </p>


        <form
          action="/flights/search"
          method="GET"
        >


          <div class="row g-3">


            <!-- FROM -->

            <div class="col-md-6">

              <label class="form-label flight-label">

                From

              </label>


              <input
                type="text"
                name="source"
                class="form-control flight-input"
                placeholder="e.g. Delhi"
                required
              >

            </div>


            <!-- TO -->

            <div class="col-md-6">

              <label class="form-label flight-label">

                To

              </label>


              <input
                type="text"
                name="destination"
                class="form-control flight-input"
                placeholder="e.g. Mumbai"
                required
              >

            </div>


            <!-- DEPARTURE -->

            <div class="col-md-6">

              <label class="form-label flight-label">

                Departure

              </label>


              <input
                type="date"
                name="date"
                class="form-control flight-input"
              >

            </div>


            <!-- TRAVELER -->

            <div class="col-md-6">

              <label class="form-label flight-label">

                Traveler(s) & Class

              </label>


              <select
                name="class"
                class="form-select flight-input"
              >

                <option value="Economy">

                  1 Adult, Economy

                </option>


                <option value="Premium Economy">

                  1 Adult, Premium Economy

                </option>


                <option value="Business">

                  1 Adult, Business

                </option>


              </select>

            </div>


            <!-- SEARCH BUTTON -->

            <div class="col-12">

              <button
                type="submit"
                class="flight-search-button"
              >

                SEARCH FLIGHTS

              </button>

            </div>


          </div>


        </form>


      </div>


    </div>

  </div>

</div>



<!-- =========================================
     PRICE TAX SCRIPT
========================================= -->

<script>

  const taxSwitch =
    document.getElementById(
      "flexSwitchCheckDefault"
    );


  if (taxSwitch) {

    taxSwitch.addEventListener(
      "click",
      () => {

        const taxInfo =
          document.getElementsByClassName(
            "tax-info"
          );


        for (const info of taxInfo) {

          if (
            info.style.display !== "inline"
          ) {

            info.style.display = "inline";

          } else {

            info.style.display = "none";

          }

        }

      }
    );

  }

</script>
