<% layout("/layouts/boilerplate") %>

<style>

/* =========================================================
   PAGE
========================================================= */

body {
  background: #f7f5ff;
}

.main-home-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 30px 30px 60px;
}


/* =========================================================
   CATEGORY BAR
========================================================= */

.filters {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 18px;

  overflow-x: auto;

  padding: 22px 5px 32px;

  scrollbar-width: none;
}

.filters::-webkit-scrollbar {
  display: none;
}

.filter {
  min-width: 78px;

  flex-shrink: 0;

  text-align: center;

  text-decoration: none;

  color: #444;
}

.filter-icon {
  width: 56px;
  height: 56px;

  margin: 0 auto 9px;

  background: #ffffff;

  border-radius: 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);

  transition: all 0.2s ease;
}

.filter-icon i {
  font-size: 22px;

  color: #635bff;
}

.filter p {
  margin: 0;

  font-size: 14px;

  color: #444;

  white-space: nowrap;
}

.filter:hover {
  color: #635bff;
}

.filter:hover .filter-icon {
  transform: translateY(-3px);

  box-shadow: 0 7px 18px rgba(99, 91, 255, 0.15);
}

.filter:hover p {
  color: #635bff;
}


/* =========================================================
   FLIGHT SEARCH CARD
========================================================= */

.flight-search-section {
  background: #ffffff;

  border: 1px solid #e7e4f0;

  border-radius: 22px;

  padding: 25px 30px 24px;

  box-shadow: 0 7px 25px rgba(0, 0, 0, 0.055);
}


/* =========================================================
   FLIGHT HEADER
========================================================= */

.flight-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 20px;
}

.flight-header-left {
  display: flex;

  align-items: center;

  gap: 13px;
}

.flight-main-icon {
  width: 48px;
  height: 48px;

  border-radius: 14px;

  background: #f0edff;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
}

.flight-main-icon i {
  color: #635bff;

  font-size: 22px;
}

.flight-title {
  margin: 0;

  font-size: 22px;

  font-weight: 700;

  color: #222;
}

.flight-subtitle {
  margin: 2px 0 0;

  color: #777;

  font-size: 14px;
}


/* =========================================================
   EASY BOOKING
========================================================= */

.easy-booking {
  display: flex;

  align-items: center;

  gap: 7px;

  padding: 8px 14px;

  background: #effbf3;

  color: #29934b;

  border-radius: 20px;

  font-size: 13px;

  font-weight: 600;

  white-space: nowrap;
}

.easy-booking i {
  font-size: 13px;
}


/* =========================================================
   FLIGHT FORM
========================================================= */

.flight-form-row {
  display: grid;

  grid-template-columns:
    1fr
    1fr
    1fr
    1fr
    140px;

  gap: 12px;

  align-items: end;
}

.flight-field {
  min-width: 0;
}

.flight-label {
  display: block;

  font-size: 13px;

  font-weight: 600;

  color: #555;

  margin: 0 0 6px 4px;
}

.flight-input-wrapper {
  position: relative;
}

.flight-input {
  width: 100%;

  height: 78px;

  border: 1px solid #e2e0e8;

  border-radius: 12px;

  background: #fff;

  padding: 25px 14px 8px;

  font-size: 16px;

  color: #222;

  outline: none;

  transition: all 0.2s ease;
}

.flight-input:focus {
  border-color: #635bff;

  box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.08);
}

.flight-input::placeholder {
  color: #222;

  opacity: 1;
}

.flight-small-text {
  position: absolute;

  left: 14px;

  bottom: 8px;

  color: #a0a0ad;

  font-size: 12px;

  pointer-events: none;
}

.flight-input[type="date"] {
  padding-top: 24px;
}

.flight-select {
  width: 100%;

  height: 78px;

  border: 1px solid #e2e0e8;

  border-radius: 12px;

  background: #fff;

  padding: 0 36px 0 14px;

  font-size: 16px;

  color: #222;

  outline: none;

  cursor: pointer;
}

.flight-select:focus {
  border-color: #635bff;

  box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.08);
}


/* =========================================================
   SEARCH BUTTON
========================================================= */

.flight-search-button {
  width: 100%;

  height: 78px;

  border: none;

  border-radius: 12px;

  background: #635bff;

  color: #fff;

  font-size: 16px;

  font-weight: 700;

  cursor: pointer;

  transition: all 0.2s ease;
}

.flight-search-button:hover {
  background: #5149e8;

  transform: translateY(-1px);
}


/* =========================================================
   SPECIAL FARES
========================================================= */

.special-fares {
  display: flex;

  align-items: center;

  gap: 18px;

  border-top: 1px solid #eeeeee;

  margin-top: 18px;

  padding-top: 16px;
}

.special-fares-label {
  min-width: 105px;
}

.more-benefits {
  display: inline-block;

  background: #635bff;

  color: #fff;

  border-radius: 12px;

  padding: 3px 10px;

  font-size: 10px;

  font-weight: 700;

  margin-bottom: 5px;
}

.special-fares-title {
  margin: 0;

  font-size: 15px;

  font-weight: 600;

  color: #222;
}

.fare-options {
  display: flex;

  gap: 12px;

  flex-wrap: wrap;
}

.fare-option {
  min-width: 165px;

  height: 58px;

  display: flex;

  align-items: center;

  gap: 10px;

  padding: 8px 13px;

  border: 1px solid #e4e2eb;

  border-radius: 11px;

  background: #fff;

  transition: all 0.2s ease;
}

.fare-option:hover {
  border-color: #635bff;

  background: #faf9ff;
}

.fare-option.active {
  border-color: #635bff;

  background: #faf9ff;
}

.fare-check {
  width: 18px;
  height: 18px;

  border: 1px solid #ddd;

  border-radius: 4px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;
}

.fare-option.active .fare-check {
  background: #635bff;

  border-color: #635bff;

  color: #fff;
}

.fare-check i {
  font-size: 10px;
}

.fare-icon {
  font-size: 20px;

  width: 25px;

  text-align: center;
}

.fare-text strong {
  display: block;

  font-size: 14px;

  color: #222;
}

.fare-text span {
  display: block;

  font-size: 11px;

  color: #888;

  margin-top: 2px;
}


/* =========================================================
   ROOMS & STAYS HEADER
========================================================= */

.rooms-section-header {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  margin-top: 48px;

  margin-bottom: 22px;
}

.rooms-label {
  font-size: 12px;

  font-weight: 700;

  color: #635bff;

  letter-spacing: 0.8px;

  margin-bottom: 5px;
}

.rooms-title {
  margin: 0;

  font-size: 30px;

  line-height: 1.1;

  font-weight: 700;

  color: #1f2850;
}

.rooms-subtitle {
  margin: 6px 0 0;

  font-size: 15px;

  color: #777;
}

.view-more {
  display: inline-flex;

  align-items: center;

  gap: 10px;

  padding: 12px 18px;

  border-radius: 25px;

  background: #fff;

  border: 1px solid #e5e2f0;

  color: #635bff;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);

  transition: all 0.2s ease;
}

.view-more:hover {
  color: #5149e8;

  transform: translateX(2px);

  box-shadow: 0 6px 16px rgba(99, 91, 255, 0.12);
}


/* =========================================================
   ROOM CARDS
========================================================= */

.listing-col {
  align-self: flex-start !important;
}

.listing-link {
  display: block;

  text-decoration: none;

  color: inherit;
}

.listing-link:hover {
  color: inherit;
}

.room-card {
  border: none;

  border-radius: 16px;

  overflow: hidden;

  background: #fff;

  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);

  transition: all 0.2s ease;
}

.room-card:hover {
  transform: translateY(-4px);

  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.13);
}

.room-image-wrapper {
  position: relative;

  overflow: hidden;
}

.room-image {
  width: 100%;

  height: 235px;

  object-fit: cover;

  display: block;

  transition: transform 0.3s ease;
}

.room-card:hover .room-image {
  transform: scale(1.03);
}

.favorite-button {
  position: absolute;

  top: 12px;

  right: 12px;

  width: 38px;

  height: 38px;

  border: none;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.95);

  display: flex;

  align-items: center;

  justify-content: center;

  color: #635bff;

  font-size: 16px;

  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
}

.room-card-body {
  padding: 14px 5px 8px;
}

.room-card-title {
  font-size: 16px;

  font-weight: 600;

  color: #222;

  margin-bottom: 5px;
}

.room-card-price {
  font-size: 15px;

  font-weight: 600;

  color: #222;
}

.room-card-price span {
  color: #777;

  font-weight: 400;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-listings {
  text-align: center;

  padding: 50px 20px;

  color: #777;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .flight-form-row {
    grid-template-columns:
      1fr
      1fr
      1fr;
  }

  .flight-search-button {
    width: 100%;
  }

  .special-fares {
    align-items: flex-start;

    flex-direction: column;
  }

}


@media (max-width: 768px) {

  .main-home-container {
    padding: 0 15px 45px;
  }

  .filters {
    justify-content: flex-start;

    gap: 18px;

    padding-bottom: 22px;
  }

  .filter {
    min-width: 70px;
  }

  .filter-icon {
    width: 53px;

    height: 53px;
  }

  .filter-icon i {
    font-size: 20px;
  }

  .flight-search-section {
    padding: 20px 16px;

    border-radius: 18px;
  }

  .flight-header {
    align-items: flex-start;
  }

  .flight-header-left {
    align-items: flex-start;
  }

  .flight-title {
    font-size: 20px;
  }

  .flight-subtitle {
    font-size: 13px;
  }

  .easy-booking {
    display: none;
  }

  .flight-form-row {
    grid-template-columns: 1fr;
  }

  .flight-input,
  .flight-select,
  .flight-search-button {
    height: 62px;
  }

  .special-fares {
    gap: 12px;
  }

  .fare-options {
    width: 100%;
  }

  .fare-option {
    min-width: 100%;

    width: 100%;
  }

  .rooms-section-header {
    align-items: flex-start;

    flex-direction: column;

    gap: 15px;

    margin-top: 35px;
  }

  .rooms-title {
    font-size: 25px;
  }

  .view-more {
    align-self: flex-end;
  }

  .room-image {
    height: 220px;
  }

}

</style>


<!-- =========================================================
     MAIN CONTAINER
========================================================= -->

<div class="main-home-container">


  <!-- =======================================================
       CATEGORY FILTERS
  ======================================================= -->

  <div class="filters">


    <!-- TRENDING -->

    <a
      href="/listings?category=trending"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-fire"></i>
      </div>

      <p>Trending</p>

    </a>


    <!-- ROOMS -->

    <a
      href="/listings?category=rooms"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-bed"></i>
      </div>

      <p>Rooms</p>

    </a>


    <!-- FLIGHTS -->

    <a
      href="/flights"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-plane"></i>
      </div>

      <p>Flights</p>

    </a>


    <!-- BUS -->

    <a
      href="/buses"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-bus"></i>
      </div>

      <p>Bus</p>

    </a>


    <!-- TAXI -->

    <a
      href="/listings?category=taxi"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-taxi"></i>
      </div>

      <p>Taxi</p>

    </a>


    <!-- BIKE -->

    <a
      href="/bikes"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-motorcycle"></i>
      </div>

      <p>Bike</p>

    </a>


    <!-- TRAIN -->

    <a
      href="/listings?category=train"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-train-tram"></i>
      </div>

      <p>Train</p>

    </a>


    <!-- CITIES -->

    <a
      href="/listings?category=cities"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-mountain-city"></i>
      </div>

      <p>Cities</p>

    </a>


    <!-- MOUNTAINS -->

    <a
      href="/listings?category=mountains"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-mountain"></i>
      </div>

      <p>Mountains</p>

    </a>


    <!-- SWIMMING -->

    <a
      href="/listings?category=swimming"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-person-swimming"></i>
      </div>

      <p>Swimming</p>

    </a>


    <!-- CAMPING -->

    <a
      href="/listings?category=camping"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-campground"></i>
      </div>

      <p>Camping</p>

    </a>


    <!-- FARMS -->

    <a
      href="/listings?category=farms"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-plate-wheat"></i>
      </div>

      <p>Farms</p>

    </a>


    <!-- ARCTIC -->

    <a
      href="/listings?category=arctic"
      class="filter"
    >

      <div class="filter-icon">
        <i class="fa-solid fa-snowflake"></i>
      </div>

      <p>Arctic</p>

    </a>


  </div>


  <!-- =======================================================
       FLIGHT SEARCH
  ======================================================= -->

  <div class="flight-search-section">


    <!-- HEADER -->

    <div class="flight-header">


      <div class="flight-header-left">


        <div class="flight-main-icon">
          <i class="fa-solid fa-plane-departure"></i>
        </div>


        <div>

          <h2 class="flight-title">
            Find your next flight
          </h2>

          <p class="flight-subtitle">
            Compare routes and book your journey in a few steps.
          </p>

        </div>


      </div>


      <!-- EASY BOOKING -->

      <div class="easy-booking">

        <i class="fa-solid fa-shield-halved"></i>

        Easy booking

      </div>


    </div>


    <!-- SEARCH FORM -->

    <form
      action="/flights/search"
      method="GET"
    >


      <div class="flight-form-row">


        <!-- FROM -->

        <div class="flight-field">

          <label class="flight-label">
            From
          </label>

          <div class="flight-input-wrapper">

            <input
              type="text"
              name="source"
              class="flight-input"
              placeholder="e.g. Delhi"
              required
            >

            <span class="flight-small-text">
              Departure Airport
            </span>

          </div>

        </div>


        <!-- TO -->

        <div class="flight-field">

          <label class="flight-label">
            To
          </label>

          <div class="flight-input-wrapper">

            <input
              type="text"
              name="destination"
              class="flight-input"
              placeholder="e.g. Mumbai"
              required
            >

            <span class="flight-small-text">
              Arrival Airport
            </span>

          </div>

        </div>


        <!-- DEPARTURE -->

        <div class="flight-field">

          <label class="flight-label">
            Departure
          </label>

          <div class="flight-input-wrapper">

            <input
              type="date"
              name="date"
              class="flight-input"
            >

            <span class="flight-small-text">
              Travel Day
            </span>

          </div>

        </div>


        <!-- TRAVELER -->

        <div class="flight-field">

          <label class="flight-label">
            Traveler(s) & Class
          </label>

          <select
            name="class"
            class="flight-select"
          >

            <option value="Economy">
              1 Adult, Economy
            </option>

            <option value="Premium Economy">
              1 Adult, Premium Economy
            </option>

            <option value="Business">
              1 Adult, Business
            </option>

          </select>

        </div>


        <!-- SEARCH -->

        <div class="flight-field">

          <button
            type="submit"
            class="flight-search-button"
          >
            SEARCH
          </button>

        </div>


      </div>


    </form>


    <!-- =====================================================
         SPECIAL FARES
    ===================================================== -->

    <div class="special-fares">


      <div class="special-fares-label">

        <div class="more-benefits">
          More Benefits
        </div>

        <p class="special-fares-title">
          Special Fares
        </p>

      </div>


      <div class="fare-options">


        <!-- REGULAR -->

        <div class="fare-option active">

          <div class="fare-check">

            <i class="fa-solid fa-check"></i>

          </div>

          <div class="fare-icon">
            👨‍💼
          </div>

          <div class="fare-text">

            <strong>
              Regular
            </strong>

            <span>
              Lowest Fares
            </span>

          </div>

        </div>


        <!-- STUDENT -->

        <div class="fare-option">

          <div class="fare-check"></div>

          <div class="fare-icon">
            🎓
          </div>

          <div class="fare-text">

            <strong>
              Student
            </strong>

            <span>
              Extra Baggage
            </span>

          </div>

        </div>


        <!-- SENIOR -->

        <div class="fare-option">

          <div class="fare-check"></div>

          <div class="fare-icon">
            👴
          </div>

          <div class="fare-text">

            <strong>
              Senior Citizen
            </strong>

            <span>
              Exclusive Discount
            </span>

          </div>

        </div>


      </div>


    </div>


  </div>


  <!-- =======================================================
       ROOMS & STAYS HEADER
  ======================================================= -->

  <div class="rooms-section-header">


    <div>

      <div class="rooms-label">
        FIND YOUR NEXT STAY
      </div>

      <h2 class="rooms-title">
        Rooms & stays
      </h2>

      <p class="rooms-subtitle">
        Handpicked places for your next trip.
      </p>

    </div>


    <a
      href="/listings"
      class="view-more"
    >

      View more

      <i class="fa-solid fa-arrow-right"></i>

    </a>


  </div>


  <!-- =======================================================
       ROOM CARDS
  ======================================================= -->

  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">


    <% if (allListings && allListings.length > 0) { %>


      <% for (let listing of allListings) { %>


        <div class="col listing-col">


          <a
            href="/listings/<%= listing._id %>"
            class="listing-link"
          >


            <div class="room-card">


              <!-- IMAGE -->

              <div class="room-image-wrapper">


                <img
                  src="<%= listing.image.url %>"
                  class="room-image"
                  alt="<%= listing.title %>"
                >


                <!-- HEART -->

                <button
                  type="button"
                  class="favorite-button"
                  onclick="event.preventDefault(); event.stopPropagation();"
                >

                  <i class="fa-regular fa-heart"></i>

                </button>


              </div>


              <!-- BODY -->

              <div class="room-card-body">


                <div class="room-card-title">

                  <%= listing.title %>

                </div>


                <div class="room-card-price">

                  ₹ <%= listing.price.toLocaleString("en-IN") %>

                  <span>
                    / night
                  </span>

                </div>


              </div>


            </div>


          </a>


        </div>


      <% } %>


    <% } else { %>


      <div class="col-12">

        <div class="empty-listings">

          No rooms available right now.

        </div>

      </div>


    <% } %>


  </div>


</div>
