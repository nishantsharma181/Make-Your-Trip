<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mb-5">
  <div class="col-lg-10">

    <a href="/cabs/<%= cab._id %>" class="text-decoration-none fw-semibold">
      <i class="fa-solid fa-arrow-left"></i> Back to cab
    </a>

    <h1 class="mt-3 mb-1">Book <%= cab.vehicleName %></h1>
    <p class="text-muted mb-4">Enter your trip details. The fare is calculated for you.</p>

    <div class="row g-4">

      <!-- Cab summary -->
      <div class="col-md-5">
        <div class="card shadow-sm h-100">
          <% if (cab.image && cab.image.url) { %>
            <img
              src="<%= cab.image.url %>"
              alt="<%= cab.vehicleName %>"
              class="card-img-top"
              style="height:200px; object-fit:cover;"
            >
          <% } %>
          <div class="card-body">
            <h4 class="card-title mb-1"><%= cab.vehicleName %></h4>
            <p class="text-muted mb-3">
              <%= cab.vehicleType %> · <%= cab.fuelType %> ·
              <%= cab.capacity.passengers %> seats
            </p>
            <p class="mb-1"><i class="fa-solid fa-location-dot"></i> <%= cab.operatingCity %></p>
            <p class="mb-3"><i class="fa-solid fa-user"></i> Driver: <%= cab.driver.name %></p>
            <hr>
            <div class="d-flex justify-content-between mb-1">
              <span>Base fare</span>
              <strong>₹<%= cab.pricing.baseFare %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span>Per km</span>
              <strong>₹<%= cab.pricing.pricePerKm %></strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking form -->
      <div class="col-md-7">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <form action="/bookings/cabs" method="POST">

              <input type="hidden" name="cabId" value="<%= cab._id %>">

              <div class="mb-3">
                <label class="form-label fw-semibold" for="tripType">Trip type</label>
                <select name="tripType" id="tripType" class="form-select">
                  <% (cab.serviceTypes && cab.serviceTypes.length ? cab.serviceTypes : ["One-Way"]).forEach((type) => { %>
                    <option value="<%= type %>"><%= type %></option>
                  <% }) %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" for="pickup">Pickup address</label>
                <input type="text" name="pickup" id="pickup" class="form-control" maxlength="200" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" for="drop">Drop address</label>
                <input type="text" name="drop" id="drop" class="form-control" maxlength="200" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" for="departureTime">Pickup date &amp; time</label>
                <input type="datetime-local" name="departureTime" id="departureTime" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" for="distanceKm">Approx. distance (km)</label>
                <input type="number" name="distanceKm" id="distanceKm" class="form-control" min="1" max="3000" step="1" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" for="paymentMethod">Payment method</label>
                <select name="paymentMethod" id="paymentMethod" class="form-select">
                  <option value="UPI">UPI</option>
                  <option value="Card">Card</option>
                  <option value="NetBanking">NetBanking</option>
                  <option value="Cash On Pickup">Cash On Pickup</option>
                  <option value="Wallet">Wallet</option>
                </select>
              </div>

              <div class="alert alert-light border d-flex justify-content-between align-items-center">
                <span>Estimated fare (incl. 5% taxes)</span>
                <strong id="estimatedFare">₹0</strong>
              </div>

              <button type="submit" class="btn btn-primary w-100 py-2">
                Confirm Booking
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  (function () {
    var baseFare = <%= Number(cab.pricing.baseFare) || 0 %>;
    var perKm = <%= Number(cab.pricing.pricePerKm) || 0 %>;
    var distance = document.getElementById("distanceKm");
    var fare = document.getElementById("estimatedFare");
    var when = document.getElementById("departureTime");

    // Do not allow picking a time in the past
    var now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    when.min = now.toISOString().slice(0, 16);

    function update() {
      var km = Number(distance.value) || 0;
      var total = Math.round((baseFare + km * perKm) * 1.05);
      fare.textContent = "₹" + total.toLocaleString("en-IN");
    }

    distance.addEventListener("input", update);
    update();
  })();
</script>
