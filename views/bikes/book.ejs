<% layout("/layouts/boilerplate") %>

<div style="
  max-width:900px;
  margin:40px auto;
  padding:20px;
">

  <a
    href="/bikes/<%= bike._id %>"
    style="
      text-decoration:none;
      color:#2563eb;
      font-weight:600;
    "
  >
    ← Back to bike
  </a>


  <h1 style="
    margin-top:25px;
    margin-bottom:8px;
  ">
    Book <%= bike.name %>
  </h1>

  <p style="
    color:#64748b;
    margin-bottom:30px;
  ">
    Select your pickup and return dates
  </p>


  <div style="
    display:grid;
    grid-template-columns:1fr 1.2fr;
    gap:25px;
  ">


    <!-- BIKE SUMMARY -->

    <div style="
      background:white;
      border:1px solid #e2e8f0;
      border-radius:15px;
      padding:20px;
      box-shadow:0 5px 20px rgba(0,0,0,0.06);
    ">

      <% if (bike.image && bike.image.url) { %>

        <img
          src="<%= bike.image.url %>"
          alt="<%= bike.name %>"
          style="
            width:100%;
            height:220px;
            object-fit:cover;
            border-radius:12px;
          "
        >

      <% } %>


      <h2 style="margin-bottom:8px;">
        <%= bike.name %>
      </h2>

      <p>
        🏍️ <%= bike.type %>
      </p>

      <p>
        📍 <%= bike.location %>
      </p>

      <hr style="
        border:none;
        border-top:1px solid #e2e8f0;
        margin:20px 0;
      ">


      <div style="
        display:flex;
        justify-content:space-between;
        margin-bottom:12px;
      ">
        <span>Price / Day</span>
        <strong>₹<%= bike.pricePerDay %></strong>
      </div>


      <div style="
        display:flex;
        justify-content:space-between;
        margin-bottom:12px;
      ">
        <span>Security Deposit</span>
        <strong>₹<%= bike.securityDeposit %></strong>
      </div>


      <div style="
        display:flex;
        justify-content:space-between;
      ">
        <span>Extra Km</span>
        <strong>₹<%= bike.extraKmCharge %>/km</strong>
      </div>

    </div>


    <!-- BOOKING FORM -->

    <div style="
      background:white;
      border:1px solid #e2e8f0;
      border-radius:15px;
      padding:25px;
      box-shadow:0 5px 20px rgba(0,0,0,0.06);
    ">

      <form
        action="/bookings/bikes"
        method="POST"
      >


        <!-- BIKE ID -->

        <input
          type="hidden"
          name="bikeId"
          value="<%= bike._id %>"
        >


        <!-- PICKUP DATE -->

        <div style="margin-bottom:20px;">

          <label style="
            display:block;
            font-weight:600;
            margin-bottom:8px;
          ">
            Pickup Date
          </label>

          <input
            type="date"
            id="pickupDate"
            name="pickupDate"
            required
            style="
              width:100%;
              padding:13px;
              border:1px solid #cbd5e1;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- RETURN DATE -->

        <div style="margin-bottom:20px;">

          <label style="
            display:block;
            font-weight:600;
            margin-bottom:8px;
          ">
            Return Date
          </label>

          <input
            type="date"
            id="returnDate"
            name="returnDate"
            required
            style="
              width:100%;
              padding:13px;
              border:1px solid #cbd5e1;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- PAYMENT METHOD -->

        <div style="margin-bottom:25px;">

          <label style="
            display:block;
            font-weight:600;
            margin-bottom:8px;
          ">
            Payment Method
          </label>

          <select
            name="paymentMethod"
            style="
              width:100%;
              padding:13px;
              border:1px solid #cbd5e1;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

            <option value="UPI">
              UPI
            </option>

            <option value="Card">
              Card
            </option>

            <option value="NetBanking">
              Net Banking
            </option>

            <option value="Cash On Pickup">
              Cash On Pickup
            </option>

          </select>

        </div>


        <!-- PRICE -->

        <div style="
          background:#f8fafc;
          padding:18px;
          border-radius:10px;
          margin-bottom:20px;
        ">

          <div style="
            display:flex;
            justify-content:space-between;
            margin-bottom:10px;
          ">
            <span>Daily Rental</span>
            <strong>
              ₹<%= bike.pricePerDay %>
            </strong>
          </div>


          <div style="
            display:flex;
            justify-content:space-between;
          ">
            <span>Security Deposit</span>
            <strong>
              ₹<%= bike.securityDeposit %>
            </strong>
          </div>

        </div>


        <button
          type="submit"
          style="
            width:100%;
            padding:15px;
            border:none;
            border-radius:9px;
            background:#2563eb;
            color:white;
            font-size:16px;
            font-weight:700;
            cursor:pointer;
          "
        >
          Confirm Booking
        </button>


      </form>

    </div>

  </div>

</div>


<style>

@media (max-width: 750px) {

  div[style*="grid-template-columns:1fr 1.2fr"] {
    grid-template-columns:1fr !important;
  }

}

</style>
