<% layout("/layouts/boilerplate") %>

<div style="
  max-width:1200px;
  margin:40px auto;
  padding:20px;
">

  <!-- PAGE TITLE -->

  <h1 style="
    text-align:center;
    margin-bottom:10px;
  ">
    🏍️ Bike Rental & Booking
  </h1>

  <p style="
    text-align:center;
    color:#666;
    margin-bottom:35px;
  ">
    Rent a bike and explore your destination
  </p>


  <!-- SEARCH BOX -->

  <div style="
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    margin-bottom:35px;
  ">

    <form action="/bikes/search" method="GET">

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
        gap:15px;
      ">


        <!-- PICKUP CITY -->

        <div>

          <label>
            Pickup City
          </label>

          <input
            type="text"
            name="location"
            placeholder="e.g. Delhi"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- PICKUP DATE -->

        <div>

          <label>
            Pickup Date
          </label>

          <input
            type="date"
            name="date"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- BIKE TYPE -->

        <div>

          <label>
            Bike Type
          </label>

          <select
            id="bikeType"
            name="type"
            onchange="filterBikes()"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

            <option value="">
              All Bikes
            </option>

            <option value="Scooter">
              Scooter
            </option>

            <option value="Bike">
              Bike
            </option>

            <option value="Sports">
              Sports Bike
            </option>

            <option value="Cruiser">
              Cruiser
            </option>

          </select>

        </div>


        <!-- SEARCH BUTTON -->

        <div style="
          display:flex;
          align-items:end;
        ">

          <button
            type="submit"
            style="
              width:100%;
              padding:13px;
              border:none;
              border-radius:8px;
              background:#5d5bf6;
              color:white;
              font-weight:bold;
              cursor:pointer;
            "
          >
            SEARCH BIKES
          </button>

        </div>

      </div>

    </form>

  </div>


  <!-- AVAILABLE BIKES -->

  <h2 style="
    margin-bottom:20px;
  ">
    Available Bikes
  </h2>


  <div
    id="bikeContainer"
    style="
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:25px;
      align-items:start;
    "
  >


    <% if (bikes && bikes.length > 0) { %>


      <% bikes.forEach(function(bike) { %>


        <!-- BIKE CARD -->

        <div
          class="bike-card"
          data-type="<%= bike.type %>"

          <% if (bike.isAvailable) { %>
            onclick="window.location.href='/bikes/<%= bike._id %>'"
            title="View <%= bike.name %> details"
          <% } %>

          style="
            border-radius:15px;
            background:white;
            overflow:hidden;
            box-shadow:0 4px 15px rgba(0,0,0,0.10);

            <% if (bike.isAvailable) { %>
              cursor:pointer;
            <% } else { %>
              cursor:not-allowed;
            <% } %>
          "
        >


          <!-- BIKE IMAGE -->

          <% if (bike.image && bike.image.url) { %>

            <img
              src="<%= bike.image.url %>"
              alt="<%= bike.name %>"
              style="
                width:100%;
                height:180px;
                object-fit:cover;
                display:block;
              "
            >

          <% } else { %>

            <div style="
              width:100%;
              height:180px;
              display:flex;
              align-items:center;
              justify-content:center;
              background:#f1f5f9;
              font-size:70px;
            ">
              🏍️
            </div>

          <% } %>


          <!-- BIKE DETAILS -->

          <div style="
            padding:20px;
          ">


            <h3 style="
              margin-top:0;
              margin-bottom:10px;
            ">
              <%= bike.name %>
            </h3>


            <p>
              🏍️ <%= bike.type %>
            </p>


            <p>
              📍 <%= bike.location %>
            </p>


            <strong style="
              font-size:20px;
            ">
              ₹<%= bike.pricePerDay.toLocaleString("en-IN") %> / day
            </strong>


            <!-- BOOK NOW -->

            <% if (bike.isAvailable) { %>

              <a
                href="/bikes/<%= bike._id %>"
                onclick="event.stopPropagation()"
                style="
                  display:block;
                  width:100%;
                  margin-top:18px;
                  padding:12px;
                  border:none;
                  border-radius:8px;
                  background:#111827;
                  color:white;
                  text-decoration:none;
                  text-align:center;
                  box-sizing:border-box;
                  cursor:pointer;
                "
              >
                Book Now
              </a>

            <% } else { %>

              <button
                disabled
                onclick="event.stopPropagation()"
                style="
                  display:block;
                  width:100%;
                  margin-top:18px;
                  padding:12px;
                  border:none;
                  border-radius:8px;
                  background:#9ca3af;
                  color:white;
                "
              >
                Currently Unavailable
              </button>

            <% } %>


          </div>

        </div>


      <% }) %>


    <% } else { %>


      <!-- NO BIKES -->

      <div style="
        grid-column:1/-1;
        text-align:center;
        padding:50px;
        background:white;
        border-radius:15px;
      ">

        <h3>
          No bikes available
        </h3>

        <p style="color:#666;">
          Please try again later.
        </p>

      </div>


    <% } %>


  </div>


  <!-- NO FILTER RESULT -->

  <div
    id="noResult"
    style="
      display:none;
      text-align:center;
      padding:40px;
      margin-top:20px;
      background:white;
      border-radius:15px;
    "
  >

    <h3>
      No bikes found
    </h3>

  </div>

</div>


<!-- BIKE FILTER JAVASCRIPT -->

<script>

  function filterBikes() {

    const selectedType =
      document.getElementById("bikeType").value;

    const bikes =
      document.querySelectorAll(".bike-card");

    const noResult =
      document.getElementById("noResult");

    let visibleCount = 0;


    bikes.forEach(function(bike) {

      const bikeType =
        bike.getAttribute("data-type");


      if (
        selectedType === "" ||
        bikeType === selectedType
      ) {

        bike.style.display = "block";

        visibleCount++;

      } else {

        bike.style.display = "none";

      }

    });


    if (visibleCount === 0) {

      noResult.style.display = "block";

    } else {

      noResult.style.display = "none";

    }

  }


  // MOBILE RESPONSIVE

  function makeBikeGridResponsive() {

    const container =
      document.getElementById("bikeContainer");

    if (!container) return;


    if (window.innerWidth <= 700) {

      container.style.gridTemplateColumns = "1fr";

    } else if (window.innerWidth <= 1000) {

      container.style.gridTemplateColumns = "repeat(2, 1fr)";

    } else {

      container.style.gridTemplateColumns = "repeat(3, 1fr)";

    }

  }


  window.addEventListener(
    "resize",
    makeBikeGridResponsive
  );

  makeBikeGridResponsive();

</script>
