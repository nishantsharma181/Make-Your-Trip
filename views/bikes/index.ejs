<% layout("/layouts/boilerplate") %>

<div style="
  max-width:1200px;
  margin:40px auto;
  padding:20px;
">

  <!-- PAGE TITLE -->

  <h1 style="
    text-align:center;
    margin-bottom:10px;
  ">
    🏍️ Bike Rental & Booking
  </h1>

  <p style="
    text-align:center;
    color:#666;
    margin-bottom:35px;
  ">
    Rent a bike and explore your destination
  </p>


  <!-- SEARCH BOX -->

  <div style="
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    margin-bottom:35px;
  ">

    <form action="/bikes/search" method="GET">

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
        gap:15px;
      ">

        <!-- PICKUP CITY -->

        <div>

          <label>
            Pickup City
          </label>

          <input
            type="text"
            name="location"
            placeholder="e.g. Delhi"
            required
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- PICKUP DATE -->

        <div>

          <label>
            Pickup Date
          </label>

          <input
            type="date"
            name="date"
            required
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

        </div>


        <!-- BIKE TYPE -->

        <div>

          <label>
            Bike Type
          </label>

          <select
            name="type"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >

            <option value="">
              All Bikes
            </option>

            <option value="Scooter">
              Scooter
            </option>

            <option value="Bike">
              Bike
            </option>

            <option value="Sports">
              Sports Bike
            </option>

          </select>

        </div>


        <!-- SEARCH BUTTON -->

        <div style="
          display:flex;
          align-items:end;
        ">

          <button
            type="submit"
            style="
              width:100%;
              padding:13px;
              border:none;
              border-radius:8px;
              background:#5d5bf6;
              color:white;
              font-weight:bold;
              cursor:pointer;
            "
          >
            SEARCH BIKES
          </button>

        </div>

      </div>

    </form>

  </div>


  <!-- AVAILABLE BIKES -->

  <h2 style="
    margin-bottom:20px;
  ">
    Available Bikes
  </h2>


  <div style="
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
  ">


    <!-- ========================= -->
    <!-- BIKE 1 - HONDA ACTIVA -->
    <!-- ========================= -->

    <div style="
      border-radius:15px;
      background:white;
      overflow:hidden;
      box-shadow:0 4px 15px rgba(0,0,0,0.10);
    ">

      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Honda_Activa_6G.jpg"
        alt="Honda Activa 6G"
        style="
          width:100%;
          height:220px;
          object-fit:cover;
          display:block;
        "
      >

      <div style="
        padding:20px;
      ">

        <h3 style="
          margin-top:0;
        ">
          Honda Activa 6G
        </h3>

        <p>
          🛵 Scooter
        </p>

        <p>
          📍 Delhi
        </p>

        <strong style="
          font-size:20px;
        ">
          ₹499 / day
        </strong>

        <button
          style="
            display:block;
            width:100%;
            margin-top:18px;
            padding:12px;
            border:none;
            border-radius:8px;
            background:#111827;
            color:white;
            cursor:pointer;
          "
        >
          Book Now
        </button>

      </div>

    </div>


    <!-- =============================== -->
    <!-- BIKE 2 - ROYAL ENFIELD CLASSIC -->
    <!-- =============================== -->

    <div style="
      border-radius:15px;
      background:white;
      overflow:hidden;
      box-shadow:0 4px 15px rgba(0,0,0,0.10);
    ">

      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Royal_Enfield_Classic_350.jpg"
        alt="Royal Enfield Classic 350"
        style="
          width:100%;
          height:220px;
          object-fit:cover;
          display:block;
        "
      >

      <div style="
        padding:20px;
      ">

        <h3 style="
          margin-top:0;
        ">
          Royal Enfield Classic 350
        </h3>

        <p>
          🏍️ Bike
        </p>

        <p>
          📍 Jaipur
        </p>

        <strong style="
          font-size:20px;
        ">
          ₹999 / day
        </strong>

        <button
          style="
            display:block;
            width:100%;
            margin-top:18px;
            padding:12px;
            border:none;
            border-radius:8px;
            background:#111827;
            color:white;
            cursor:pointer;
          "
        >
          Book Now
        </button>

      </div>

    </div>


    <!-- ================= -->
    <!-- BIKE 3 - KTM DUKE -->
    <!-- ================= -->

    <div style="
      border-radius:15px;
      background:white;
      overflow:hidden;
      box-shadow:0 4px 15px rgba(0,0,0,0.10);
    ">

      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Ktm_duke_390.jpg"
        alt="KTM Duke 390"
        style="
          width:100%;
          height:220px;
          object-fit:cover;
          display:block;
        "
      >

      <div style="
        padding:20px;
      ">

        <h3 style="
          margin-top:0;
        ">
          KTM Duke 390
        </h3>

        <p>
          🏍️ Sports Bike
        </p>

        <p>
          📍 Goa
        </p>

        <strong style="
          font-size:20px;
        ">
          ₹1,499 / day
        </strong>

        <button
          style="
            display:block;
            width:100%;
            margin-top:18px;
            padding:12px;
            border:none;
            border-radius:8px;
            background:#111827;
            color:white;
            cursor:pointer;
          "
        >
          Book Now
        </button>

      </div>

    </div>


  </div>

</div>
