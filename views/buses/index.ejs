<% layout("/layouts/boilerplate") %>

<div style="max-width:1200px; margin:40px auto; padding:20px;">

  <!-- Header -->
  <div style="text-align:center; margin-bottom:35px;">
    <h1 style="margin-bottom:10px;">
      🚌 Bus Booking
    </h1>

    <p style="color:#666;">
      Search and book buses easily
    </p>
  </div>

  <!-- Search Box -->
  <div style="
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    margin-bottom:35px;
  ">

    <form action="/buses/search" method="GET">

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
        gap:15px;
        align-items:end;
      ">

        <!-- From -->
        <div>
          <label style="font-weight:600;">From</label>

          <input
            type="text"
            name="from"
            value="<%= from || '' %>"
            placeholder="e.g. Delhi"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >
        </div>

        <!-- To -->
        <div>
          <label style="font-weight:600;">To</label>

          <input
            type="text"
            name="to"
            value="<%= to || '' %>"
            placeholder="e.g. Jaipur"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
            "
          >
        </div>

        <!-- Bus Type -->
        <div>
          <label style="font-weight:600;">Bus Type</label>

          <select
            name="type"
            style="
              width:100%;
              padding:12px;
              margin-top:7px;
              border:1px solid #ddd;
              border-radius:8px;
              box-sizing:border-box;
              background:white;
            "
          >
            <option value="">All Bus Types</option>

            <option
              value="AC Sleeper"
              <%= selectedType === "AC Sleeper" ? "selected" : "" %>
            >
              AC Sleeper
            </option>

            <option
              value="Non-AC Sleeper"
              <%= selectedType === "Non-AC Sleeper" ? "selected" : "" %>
            >
              Non-AC Sleeper
            </option>

            <option
              value="AC Seater"
              <%= selectedType === "AC Seater" ? "selected" : "" %>
            >
              AC Seater
            </option>

            <option
              value="Non-AC Seater"
              <%= selectedType === "Non-AC Seater" ? "selected" : "" %>
            >
              Non-AC Seater
            </option>

            <option
              value="AC Seater/Sleeper"
              <%= selectedType === "AC Seater/Sleeper" ? "selected" : "" %>
            >
              AC Seater/Sleeper
            </option>
          </select>
        </div>

        <!-- Search Button -->
        <div>
          <button
            type="submit"
            style="
              width:100%;
              padding:13px;
              border:none;
              border-radius:8px;
              background:#5d5bf6;
              color:white;
              font-weight:bold;
              cursor:pointer;
            "
          >
            SEARCH BUSES
          </button>
        </div>

      </div>

    </form>

  </div>


  <!-- Available Buses -->
  <h2 style="margin-bottom:20px;">
    Available Buses
  </h2>


  <% if (!buses || buses.length === 0) { %>

    <div style="
      background:white;
      padding:40px;
      text-align:center;
      border-radius:15px;
      box-shadow:0 3px 12px rgba(0,0,0,0.08);
    ">
      <h3>No buses found</h3>
      <p style="color:#666;">
        Try another route or bus type.
      </p>
    </div>

  <% } else { %>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:20px;
    ">

      <% buses.forEach(bus => { %>

        <div
          onclick="window.location.href='/buses/<%= bus._id %>'"
          style="
            background:white;
            border-radius:15px;
            overflow:hidden;
            box-shadow:0 3px 12px rgba(0,0,0,0.08);
            cursor:pointer;
            transition:transform 0.2s;
          "
        >

          <% if (bus.image && bus.image.url) { %>

            <img
              src="<%= bus.image.url %>"
              alt="<%= bus.operator %>"
              style="
                width:100%;
                height:180px;
                object-fit:cover;
              "
            >

          <% } %>


          <div style="padding:20px;">

            <h3 style="margin-top:0;">
              <%= bus.from %> → <%= bus.to %>
            </h3>

            <p style="color:#555;">
              🚌 <%= bus.operator %>
            </p>

            <p>
              <strong><%= bus.busType %></strong>
            </p>

            <p>
              ⏰ <%= bus.departureTime %>
              → <%= bus.arrivalTime %>
            </p>

            <p>
              ⏱️ Duration: <%= bus.duration %>
            </p>

            <p>
              💺 <%= bus.seatsAvailable %> seats available
            </p>

            <h3 style="margin-bottom:15px;">
              ₹<%= bus.price %> / ticket
            </h3>

            <a
              href="/buses/<%= bus._id %>"
              onclick="event.stopPropagation();"
              style="
                display:block;
                width:100%;
                box-sizing:border-box;
                text-align:center;
                padding:11px;
                border-radius:8px;
                background:#111827;
                color:white;
                text-decoration:none;
                font-weight:bold;
              "
            >
              View Details
            </a>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</div>
