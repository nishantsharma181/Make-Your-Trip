<% layout("/layouts/boilerplate") %>

<div style="max-width:900px; margin:40px auto; padding:20px;">

  <div style="
    background:white;
    padding:35px;
    border-radius:18px;
    box-shadow:0 4px 18px rgba(0,0,0,0.10);
  ">

    <div style="text-align:center;">

      <div style="
        width:70px;
        height:70px;
        margin:0 auto 15px;
        border-radius:50%;
        background:#e8f8ee;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:35px;
      ">
        ✓
      </div>

      <h1 style="margin-bottom:8px;">
        Booking Confirmed!
      </h1>

      <p style="color:#666;">
        Your bus booking has been successfully created.
      </p>

    </div>


    <hr style="
      border:none;
      border-top:1px solid #eee;
      margin:30px 0;
    ">


    <!-- Bus Details -->
    <h2>🚌 Bus Details</h2>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
      gap:15px;
      margin-top:20px;
    ">

      <div>
        <strong>Operator</strong>
        <p><%= bus.operator %></p>
      </div>

      <div>
        <strong>Route</strong>
        <p>
          <%= bus.from %> → <%= bus.to %>
        </p>
      </div>

      <div>
        <strong>Bus Type</strong>
        <p><%= bus.busType %></p>
      </div>

      <div>
        <strong>Departure</strong>
        <p><%= bus.departureTime %></p>
      </div>

      <div>
        <strong>Arrival</strong>
        <p><%= bus.arrivalTime %></p>
      </div>

      <div>
        <strong>Boarding Point</strong>
        <p><%= booking.boardingPoint %></p>
      </div>

      <div>
        <strong>Dropping Point</strong>
        <p><%= booking.droppingPoint %></p>
      </div>

    </div>


    <hr style="
      border:none;
      border-top:1px solid #eee;
      margin:30px 0;
    ">


    <!-- Passenger Details -->
    <h2>👤 Passenger Details</h2>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
      gap:15px;
      margin-top:20px;
    ">

      <div>
        <strong>Name</strong>
        <p><%= booking.passengerName %></p>
      </div>

      <div>
        <strong>Age</strong>
        <p><%= booking.passengerAge %></p>
      </div>

      <div>
        <strong>Gender</strong>
        <p><%= booking.passengerGender %></p>
      </div>

      <div>
        <strong>Travel Date</strong>
        <p>
          <%= new Date(booking.travelDate).toLocaleDateString("en-IN") %>
        </p>
      </div>

      <div>
        <strong>Seats Booked</strong>
        <p><%= booking.seatsBooked %></p>
      </div>

    </div>


    <!-- Payment / Amount -->
    <div style="
      margin-top:30px;
      padding:22px;
      border-radius:12px;
      background:#f8f9ff;
    ">

      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:15px;
        flex-wrap:wrap;
      ">

        <div>
          <div style="color:#666;">
            Total Amount
          </div>

          <strong style="font-size:28px;">
            ₹<%= booking.totalAmount %>
          </strong>
        </div>


        <div>
          <div style="color:#666;">
            Payment Status
          </div>

          <strong>
            <%= booking.paymentStatus %>
          </strong>
        </div>

      </div>

    </div>


    <!-- Booking Status -->
    <div style="
      margin-top:20px;
      padding:15px;
      border-radius:10px;
      background:#e8f8ee;
      color:#176b35;
      text-align:center;
      font-weight:bold;
    ">
      Booking Status: <%= booking.bookingStatus %>
    </div>


    <!-- Buttons -->
    <div style="
      margin-top:30px;
      display:flex;
      gap:15px;
      flex-wrap:wrap;
    ">

      <a
        href="/buses"
        style="
          flex:1;
          min-width:200px;
          text-align:center;
          padding:14px;
          background:#5d5bf6;
          color:white;
          border-radius:9px;
          text-decoration:none;
          font-weight:bold;
        "
      >
        🚌 Browse More Buses
      </a>

      <a
        href="/"
        style="
          flex:1;
          min-width:200px;
          text-align:center;
          padding:14px;
          background:#f1f1f1;
          color:#333;
          border-radius:9px;
          text-decoration:none;
          font-weight:bold;
        "
      >
        🏠 Go Home
      </a>

    </div>

  </div>

</div>
